    "clsx": "^2.1.1",
    "csv-parse": "^6.2.1",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.3",
    "dompurify": "^3.2.7",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.12",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.1",
    "motion": "^12.23.24",
